<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4EEDC"
    android:paddingHorizontal="24dp"
    android:paddingTop="42dp"
    android:paddingBottom="36dp">

    <!-- Fila Superior: Temporizador (Izquierda) y Botón Pausa (Derecha) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Cápsula del Temporizador -->
        <LinearLayout
            android:id="@+id/layoutTemporizador"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_timer_pill"
            android:paddingStart="14dp"
            android:paddingEnd="18dp"
            android:layout_alignParentStart="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_stopwatch"
                android:layout_marginEnd="8dp"
                android:contentDescription="Temporizador" />

            <TextView
                android:id="@+id/tvTemporizador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14s"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#142232" />
        </LinearLayout>

        <!-- Botón Pausa Circular -->
        <ImageView
            android:id="@+id/btnPausa"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_pause"
            android:padding="11dp"
            android:background="@drawable/bg_btn_volver"
            android:contentDescription="Pausa"
            android:layout_alignParentEnd="true"
            android:clickable="true"
            android:focusable="true" />

    </RelativeLayout>

    <!-- Área Central de Juego: Título y Fórmula centrados -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Título / Instrucción -->
        <TextView
            android:id="@+id/textViewTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona la opción\nque resuelve la formula"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#142232"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="72dp" />

        <!-- Fórmula Central -->
        <TextView
            android:id="@+id/textoFormula"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="\? &amp; V = true"
            android:textSize="38sp"
            android:textStyle="bold"
            android:textColor="#142232"
            android:gravity="center" />

    </LinearLayout>

    <!-- Fila Inferior: Botones TRUE y FALSE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/trueButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="TRUE"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_crear_cuenta"
            android:layout_marginEnd="12dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/falseButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="FALSE"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_continuar"
            android:layout_marginStart="12dp" />

    </LinearLayout>

</LinearLayout>