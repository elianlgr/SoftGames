<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootMinijuegoBloques"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F1DE"
    android:paddingHorizontal="20dp"
    android:paddingTop="38dp"
    android:paddingBottom="24dp">

    <!-- Fila Superior: Temporizador (Izquierda), Progreso (Centro) y Botón Pausa (Derecha) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <!-- Cápsula del Temporizador -->
        <LinearLayout
            android:id="@+id/layoutTemporizador"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_timer_pill"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:layout_alignParentStart="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_stopwatch"
                android:layout_marginEnd="6dp"
                android:contentDescription="Temporizador" />

            <TextView
                android:id="@+id/tvTemporizador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="16s"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#0D1B2A" />
        </LinearLayout>

        <!-- Indicador de Pregunta / Categoría -->
        <TextView
            android:id="@+id/tvProgresoBloques"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Pregunta 1 / 5"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#415A77" />

        <!-- Botón Pausa Circular -->
        <ImageView
            android:id="@+id/btnPausa"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:src="@drawable/ic_pause"
            android:padding="10dp"
            android:background="@drawable/bg_btn_volver"
            android:contentDescription="Pausa"
            android:layout_alignParentEnd="true"
            android:clickable="true"
            android:focusable="true" />
    </RelativeLayout>

    <!-- Enunciado del Problema -->
    <TextView
        android:id="@+id/tvEnunciadoBloques"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Coloca la opción correcta para completar el fragmento de código"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#0D1B2A"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="14dp" />

    <!-- ÁREA CENTRAL DE ESTRUCTURACIÓN DE CÓDIGO / DIAGRAMA DE FLUJO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/bg_card_configurar"
        android:padding="14dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/tvSubtituloArea"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Área de Estructuración"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#415A77"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_categoria_pill"
            android:paddingHorizontal="18dp"
            android:paddingVertical="14dp">

            <!-- Código / Diagrama Superior -->
            <TextView
                android:id="@+id/tvCodigoAntes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="if (edad &gt;= 18) {"
                android:fontFamily="monospace"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#0D1B2A"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="10dp" />

            <!-- RANURA DE RESPUESTA (DROP ZONE DONDE SE ENGANCHA EL BLOQUE) -->
            <TextView
                android:id="@+id/zonaRespuestaBloque"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center"
                android:text="⬇ Arrastra el bloque aquí ⬇"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#415A77"
                android:background="@drawable/bg_drop_zone_empty"
                android:paddingHorizontal="12dp"
                android:layout_marginVertical="6dp" />

            <!-- Código / Diagrama Inferior -->
            <TextView
                android:id="@+id/tvCodigoDespues"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="}"
                android:fontFamily="monospace"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#0D1B2A"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="10dp" />

        </LinearLayout>
    </LinearLayout>

    <!-- MENÚ DE BLOQUES PREFABRICADOS DISPONIBLES -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_configurar"
        android:padding="12dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mantén presionado y arrastra un bloque al área de respuesta:"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:textColor="#1B263B"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp" />

        <!-- Fila 1 de Bloques -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/bloqueOpcion0"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Opción 1"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_bloque_codigo"
                android:paddingHorizontal="8dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/bloqueOpcion1"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Opción 2"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_bloque_codigo"
                android:paddingHorizontal="8dp"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Fila 2 de Bloques -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/bloqueOpcion2"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Opción 3"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_bloque_codigo"
                android:paddingHorizontal="8dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/bloqueOpcion3"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Opción 4"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_bloque_codigo"
                android:paddingHorizontal="8dp"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Botón Confirmar / Comprobar Respuesta -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnComprobarBloque"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="COMPROBAR RESPUESTA"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_btn_continuar" />

</LinearLayout>
