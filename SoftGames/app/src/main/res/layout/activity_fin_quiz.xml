<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F1DE"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="38dp"
        android:paddingBottom="26dp">

        <!-- 1. Título Principal -->
        <TextView
            android:id="@+id/tvTituloFinQuiz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Resultados del Quiz!"
            android:textColor="#0D1B2A"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- Píldora Subtítulo Configuración Evaluada -->
        <TextView
            android:id="@+id/tvSubtituloConfigQuiz"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dificultad: Fácil  •  10 preguntas por categoría"
            android:textColor="#0D1B2A"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:background="@drawable/bg_pill_crema"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:layout_marginBottom="20dp" />

        <!-- 2. Contenedor Principal de Puntuación (#D4C4A8) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_card_configurar"
            android:paddingHorizontal="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="16dp"
            android:layout_marginBottom="22dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <!-- Tarjeta interior crema (#FAF5EC) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:background="@drawable/bg_categoria_pill"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="30dp"
                    android:paddingBottom="18dp">

                    <!-- Puntuación Final Promedio -->
                    <TextView
                        android:id="@+id/tvPuntajeFinalQuiz"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8.5 / 10"
                        android:textColor="#0D1B2A"
                        android:textSize="42sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Puntuación Final del Quiz"
                        android:textColor="#415A77"
                        android:textSize="15sp"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="18dp" />

                    <!-- Divisor 1 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E6DEC8" />

                    <!-- Fila 1: Respuestas correctas totales -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="12dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_stat_flame"
                            android:contentDescription="Aciertos"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Preguntas acertadas:"
                            android:textColor="#0D1B2A"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvAciertosTotalesQuiz"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="26 / 30"
                            android:textColor="#0D1B2A"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Divisor 2 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E6DEC8" />

                    <!-- Fila 2: Dificultad evaluada -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="12dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_stat_gauge"
                            android:contentDescription="Dificultad"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Dificultad evaluada:"
                            android:textColor="#0D1B2A"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvDificultadEvaluadaQuiz"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fácil"
                            android:textColor="#0D1B2A"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Divisor 3 -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E6DEC8" />

                    <!-- Fila 3: Récord anterior en Modo Quiz -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="12dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_stat_trophy"
                            android:contentDescription="Récord anterior"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Récord anterior del Quiz:"
                            android:textColor="#0D1B2A"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvRecordAnteriorQuiz"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.0 pts"
                            android:textColor="#0D1B2A"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Divisor 4: Desglose de puntuación de cada categoría (Paso 7 del Caso de Uso) -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E6DEC8"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/tvTituloDesgloseQuiz"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="PUNTUACIÓN DE CADA CATEGORÍA EVALUADA"
                        android:textColor="#415A77"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:id="@+id/llDesgloseCategoriasQuiz"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>

                <!-- Insignia superior superpuesta -->
                <TextView
                    android:id="@+id/tvBadgeRecordQuiz"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_gravity="top|center_horizontal"
                    android:text="★  ¡QUIZ COMPLETADO!"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/bg_badge_verde"
                    android:paddingHorizontal="20dp" />

            </FrameLayout>

            <!-- 3. Banner de Autoguardado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_pill_crema"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_check_circle_green"
                    android:contentDescription="Guardado"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvEstadoGuardadoQuiz"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Puntuación guardada automáticamente en PARTIDA 1"
                    android:textColor="#0D1B2A"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- 4. Botones de Acción -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnJugarDeNuevoQuiz"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="JUGAR DE NUEVO"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_crear_cuenta"
            android:layout_marginBottom="12dp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnVolverMenuQuiz"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="VOLVER AL MENÚ"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_continuar" />

    </LinearLayout>
</ScrollView>
