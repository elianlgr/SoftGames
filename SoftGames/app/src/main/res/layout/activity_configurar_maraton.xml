<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F1DE"
    android:paddingHorizontal="22dp"
    android:paddingTop="38dp"
    android:paddingBottom="22dp">

    <!-- 1. Encabezado con Botón Volver y Título -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/btnVolverConfigMaraton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="←"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#0D1B2A"
            android:gravity="center"
            android:background="@drawable/bg_btn_volver"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Modo Maratón"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#0D1B2A"
            android:gravity="center"
            android:layout_marginEnd="44dp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Selecciona el Modo General o marca la(s) categoría(s) con las que deseas jugar:"
        android:textSize="13sp"
        android:textColor="#415A77"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- 2. Opción Destacada: MODO GENERAL (Todas las categorías y minijuegos) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_configurar"
        android:padding="10dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:id="@+id/cardModoGeneralMaraton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_chip_selected"
            android:paddingHorizontal="18dp"
            android:paddingVertical="14dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_mode_maraton"
                android:contentDescription="Modo General"
                android:layout_marginEnd="14dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTituloModoGeneral"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modo General (Todas)"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF" />

                <TextView
                    android:id="@+id/tvSubtituloModoGeneral"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Incluye preguntas de todas las categorías y minijuegos"
                    android:textSize="12sp"
                    android:textColor="#FAF5EC"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCheckModoGeneral"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:text="✓"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0D1B2A"
                android:gravity="center"
                android:background="@drawable/bg_pill_crema"
                android:layout_marginStart="10dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Subtítulo Categorías Individuales -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="O marca categorías específicas (Selección múltiple):"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="#0D1B2A"
        android:layout_marginBottom="10dp" />

    <!-- 3. Lista de Categorías Seleccionables -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_configurar"
            android:padding="12dp">

            <!-- Categoría 1: Lógica -->
            <LinearLayout
                android:id="@+id/itemCatMaratonLogica"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_categoria_pill"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_cat_puzzle"
                    android:contentDescription="Lógica"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTituloCatLogica"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lógica"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#0D1B2A" />

                    <TextView
                        android:id="@+id/tvSubCatLogica"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Diagramas de Venn y Fórmulas Booleanas"
                        android:textSize="11sp"
                        android:textColor="#415A77" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCheckCatLogica"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:text=""
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#0D1B2A"
                    android:gravity="center"
                    android:background="@drawable/bg_pill_crema" />
            </LinearLayout>

            <!-- Categoría 2: Programación -->
            <LinearLayout
                android:id="@+id/itemCatMaratonProgramacion"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_categoria_pill"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_cat_code"
                    android:contentDescription="Programación"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTituloCatProgramacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Programación"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#0D1B2A" />

                    <TextView
                        android:id="@+id/tvSubCatProgramacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Variables, condicionales, ciclos y funciones"
                        android:textSize="11sp"
                        android:textColor="#415A77" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCheckCatProgramacion"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:text=""
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#0D1B2A"
                    android:gravity="center"
                    android:background="@drawable/bg_pill_crema" />
            </LinearLayout>

            <!-- Categoría 3: Análisis y diseño de algoritmos -->
            <LinearLayout
                android:id="@+id/itemCatMaratonAlgoritmos"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_categoria_pill"
                android:paddingHorizontal="16dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_cat_flowchart"
                    android:contentDescription="Análisis y diseño de algoritmos"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTituloCatAlgoritmos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Análisis y diseño de algoritmos"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#0D1B2A" />

                    <TextView
                        android:id="@+id/tvSubCatAlgoritmos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Búsquedas, arreglos, recursión y lógica"
                        android:textSize="11sp"
                        android:textColor="#415A77" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvCheckCatAlgoritmos"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:text=""
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#0D1B2A"
                    android:gravity="center"
                    android:background="@drawable/bg_pill_crema" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 4. Botón EMPEZAR MARATÓN -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnEmpezarMaraton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="EMPEZAR MARATÓN"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_continuar" />

</LinearLayout>
