<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4EEDC"
    android:paddingHorizontal="28dp"
    android:paddingTop="48dp"
    android:paddingBottom="36dp">

    <!-- Encabezado con Botón de Regresar y Título -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="36dp">

        <!-- Botón Volver (Atrás) -->
        <TextView
            android:id="@+id/btnVolver"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="←"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#142232"
            android:gravity="center"
            android:background="@drawable/bg_btn_volver"
            android:clickable="true"
            android:focusable="true" />

        <!-- Título Ajustes -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ajustes"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#142232"
            android:layout_marginStart="16dp" />

    </LinearLayout>

    <!-- Contenedor central con tarjeta estilizada -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Tarjeta de configuración -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_ajustes">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Opciones"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#142232"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Más ajustes de audio, controles y personalización próximamente..."
                android:textSize="14sp"
                android:textColor="#6E5F4C"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Botón Cerrar Sesión (Terracota / Rojo elegante redondeado) -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnCerrarSesion"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="CERRAR SESIÓN"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_cerrar_sesion" />

</LinearLayout>