<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@drawable/fondo_uno">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selecciona un Modo de Juego"
        android:textColor="#000000"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="40dp"
        android:background="#CCFFFFFF"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:gravity="center"/>

    <Button
        android:id="@+id/btnModoQuiz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Modo Quiz"
        android:padding="16dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnFreePlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Free Play"
        android:padding="16dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnMaraton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Maratón"
        android:padding="16dp"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnRondaAleatoria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ronda Aleatoria"
        android:padding="16dp"
        android:layout_marginBottom="32dp"/>

</LinearLayout>
