<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F1DE"
    android:paddingHorizontal="20dp"
    android:paddingTop="36dp"
    android:paddingBottom="22dp">

    <!-- 1. Encabezado Superior: Botón Volver, Título "Estadísticas" y Archivo Activo -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/btnVolverEstadisticasTop"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="←"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#0D1B2A"
            android:gravity="center"
            android:background="@drawable/bg_btn_volver"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:clickable="true"
            android:focusable="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_centerHorizontal="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Estadísticas"
                android:textColor="#0D1B2A"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvArchivoActivoEstadisticas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Archivo activo: PARTIDA 1"
                android:textColor="#0D1B2A"
                android:textSize="12sp"
                android:background="@drawable/bg_pill_archivo_activo"
                android:paddingHorizontal="16dp"
                android:paddingVertical="5dp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

    </RelativeLayout>

    <!-- 2. Tarjeta de Resumen General (#D4C4A8 con interior #FAF5EC) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_configurar"
        android:padding="10dp"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_categoria_pill"
            android:paddingHorizontal="18dp"
            android:paddingVertical="14dp">

            <TextView
                android:id="@+id/tvPromedioGeneralEstadisticas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Promedio General: 0.0 pts"
                android:textColor="#0D1B2A"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvCategoriasJugadasEstadisticas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categorías jugadas: 0 / 8"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_badge_verde"
                android:paddingHorizontal="16dp"
                android:paddingVertical="5dp" />

        </LinearLayout>
    </LinearLayout>

    <!-- 3. Contenedor Desplazable de Tarjetas por Categoría -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card_configurar"
        android:padding="12dp"
        android:layout_marginBottom="14dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/contenedorTarjetasCategorias"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </ScrollView>
    </LinearLayout>

    <!-- 4. Botón Inferior VOLVER -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnVolverEstadisticasBottom"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="VOLVER"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_continuar" />

</LinearLayout>
