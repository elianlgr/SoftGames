<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@drawable/fondo_uno">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Seleccionar partida"
        android:textColor="#000000"
        android:textSize="24sp"
        android:layout_marginBottom="32dp"
        android:background="#CCFFFFFF"
        android:padding="12dp"/>

    <Button android:id="@+id/btnSlot0" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Partida 1" />
    <Button android:id="@+id/btnSlot1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Partida 2" />
    <Button android:id="@+id/btnSlot2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Partida 3" />

    <Button
        android:id="@+id/btnAjustesInicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AJUSTES"
        android:layout_marginTop="32dp" />

</LinearLayout>